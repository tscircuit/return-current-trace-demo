{
  "name": "@tscircuit/return-current-trace-demo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "bun scripts/serve.ts",
    "simulate": "bun scripts/simulate.ts",
    "render": "python scripts/render.py",
    "verify": "python scripts/verify.py",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:pcb": "bun scripts/em/build-pcb-view.ts && bun build scripts/em/pcb-view.ts --target browser --minify --outfile public/em/latest/pcb-view.js",
    "build:mesh": "bun build scripts/em/mesh-view.ts --target browser --minify --outfile public/em/latest/mesh-view.js"
  },
  "dependencies": {
    "@tscircuit/solver-utils": "0.0.21",
    "circuit-json": "0.0.515",
    "circuit-to-canvas": "0.0.134",
    "graphics-debug": "0.0.76",
    "three": "^0.186.1",
    "transformation-matrix": "2.16.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
