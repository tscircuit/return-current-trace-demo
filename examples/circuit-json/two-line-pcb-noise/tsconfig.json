{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": [
      "bun",
      "react"
    ]
  },
  "include": [
    "*.ts",
    "*.tsx",
    "interactive/*.ts",
    "interactive/*.tsx"
  ]
}
